#!/bin/bash
# Run taikocam using whichever Python has OpenCV: a repo-local .venv first,
# then the venv setup.sh may have made elsewhere, then the system interpreter.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in "$here/.venv/bin/python" "$HOME/Games/taikocam-venv/bin/python"; do
    if [ -x "$candidate" ]; then exec "$candidate" "$here/taikocam.py" "$@"; fi
done
exec python3 "$here/taikocam.py" "$@"
